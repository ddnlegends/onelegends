# Hosted app databases use Supabase. Automated tests use isolated local Postgres.
# URI-encode special characters in PASSWORD (@ → %40, # → %23).
# Transaction pooler (port 6543) for the Next.js app / Prisma Client:
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct or session pooler (port 5432) for Prisma migrations:
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Auth.js (Google for regular accounts; four temporary production demonstration accounts)
# Generate a new secret for production: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-use-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Required for regular sign-in. Create an OAuth client in Google Cloud.
# Authorized redirect: AUTH_URL + /api/auth/callback/google
# Hosted deployments cannot sign in without Google configured.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Enables additional legacy fixture logins only for disposable local tests.
# Production exposes only the four named demonstration accounts in auth-policy.ts.
# Preview deployments keep password login disabled.
AUTH_ENABLE_TEST_LOGIN=false
# Destructive seeds also require ALLOW_TEST_DATABASE_RESET=1 and E2E_PASSWORD.
# Supply those in your local test shell, never production.
