# Postgres is hosted on Supabase only (see SETUP.md and TECH_STACK.md). No local database.
# URI-encode special characters in PASSWORD (@ → %40, # → %23).
# Transaction pooler (port 6543) for the Next.js app / Prisma Client:
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct or session pooler (port 5432) for Prisma migrations:
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Auth.js (email/password sessions — not Supabase Auth)
# Generate a new secret for production: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-use-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Optional: Google Sheets export for each competition
# Create a Google Cloud service account, enable Sheets API, share each sheet
# with the service account email as Editor. See SETUP.md.
# Leave blank if you are not using Sheets. Google Drive AVs do not need these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
