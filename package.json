{
  "name": "legends-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:e2e": "tsx prisma/e2e-seed.ts",
    "db:reset": "prisma db seed",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit -p .",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "db:migrate:test": "tsx scripts/check-test-database.ts && prisma migrate deploy",
    "test:load": "node scripts/load-smoke.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
